<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OBSharp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只有宿主能给插件附加 ObsPluginContext。 -->
    <InternalsVisibleTo Include="OBSharp.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- 插件工程 Import（或引用包时自动导入）这个文件：把宿主提供的程序集从插件输出里去掉。 -->
    <None Include="build\OBSharp.SDK.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OBSharp.Interop\OBSharp.Interop.csproj" />
    <ProjectReference Include="..\OBSharp.Interop.Browser\OBSharp.Interop.Browser.csproj" />
  </ItemGroup>

</Project>
