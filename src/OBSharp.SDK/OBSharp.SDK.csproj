<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OBSharp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只有宿主能给插件附加 ObsPluginContext。 -->
    <InternalsVisibleTo Include="OBSharp.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- 插件日志用的抽象；有它才拿得到 ILogger/ILogger<T>/[LoggerMessage]。 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- 传递引用：插件引用 SDK 就顺带拿到 libobs 的绑定。 -->
    <ProjectReference Include="..\OBSharp.Interop\OBSharp.Interop.csproj" />
  </ItemGroup>

</Project>
