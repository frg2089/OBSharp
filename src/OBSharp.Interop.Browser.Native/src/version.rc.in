// version.rc.in: Windows 版本资源模板，由 CMake configure_file 生成。
// 版本号来自仓库根的 Directory.Version.cmake（CI 的「生成版本文件」步骤产出）。

#pragma code_page(65001)

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @OBSHARP_VERSION_RC@
 PRODUCTVERSION @OBSHARP_VERSION_RC@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OBSharp"
            VALUE "FileDescription", "OBSharp.Interop.Browser.Native"
            VALUE "FileVersion", "@OBSHARP_VERSION@"
            VALUE "InternalName", "OBSharp.Interop.Browser.Native"
            VALUE "OriginalFilename", "OBSharp.Interop.Browser.Native.dll"
            VALUE "ProductName", "OB#"
            VALUE "ProductVersion", "@OBSHARP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
