@page "/"
@using OBSharp.Interop.Browser
@rendermode InteractiveServer
@inject OBSharpPluginManager Manager
@inject PluginManagerState State

<PageTitle>OB# 插件管理器</PageTitle>

@if (State.Message is { Length: > 0 })
{
    <p class="@(State.MessageIsError ? "alert" : "alert alert-ok")" role="status">@State.Message</p>
}

<div class="add">
    <button type="button" class="btn btn-primary" @onclick="Add" disabled="@_busy">添加插件</button>
</div>

@if (Manager.Plugins.Count is 0)
{
    <p class="note">列表是空的。</p>
}
else
{
    <table class="plugins">
        <thead>
            <tr>
                <th>插件</th>
                <th>状态</th>
                <th class="right">操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Manager.Plugins)
            {
                <tr>
                    <td>
                        <div class="name">@(entry.Name ?? "Unloaded")</div>
                        <div class="note"><code>@entry.Path</code></div>
                        @if (!string.IsNullOrEmpty(entry.Description))
                        {
                            <div class="note">@entry.Description</div>
                        }
                    </td>
                    <td>
                        @switch (entry.Status)
                        {
                            case OBSharpPluginStatus.Unload:
                                <span class="status status-off">未加载</span>
                                break;
                            case OBSharpPluginStatus.Loading:
                                <span class="status status-off">加载中</span>
                                break;
                            case OBSharpPluginStatus.Loaded:
                                <span class="status status-on">已加载</span>
                                break;
                            case OBSharpPluginStatus.Unloading:
                                <span class="status status-off">卸载中</span>
                                break;
                            case OBSharpPluginStatus.Failed:
                                <span class="status status-fail">失败</span>
                                break;
                            default:
                                <span class="status status-off">未知状态</span>
                                break;
                        }
                        @if (entry.Exception is { } exception)
                        {
                            <div class="note error">@exception.Message</div>
                        }
                    </td>
                    <td class="right">
                        @switch (entry)
                        {
                            case { Instance: PluginManagerPlugin }:
                                <span class="note">面板本体</span>
                                break;
                            case { Status: OBSharpPluginStatus.Loading }:
                                <button type="button" class="btn btn-danger" @onclick="() => Remove(entry)"
                                        disabled="@_busy">移除</button>
                                break;
                            case { Status: OBSharpPluginStatus.Loaded }:
                                <button type="button" class="btn" @onclick="() => Disable(entry)" disabled="@_busy">停用</button>
                                <button type="button" class="btn btn-danger" @onclick="() => Remove(entry)"
                                        disabled="@_busy">移除</button>
                                break;
                            case { Status: OBSharpPluginStatus.Unloading }:
                                <button type="button" class="btn btn-danger" @onclick="() => Remove(entry)"
                                        disabled="@_busy">移除</button>
                                break;
                            case { Status: OBSharpPluginStatus.Unload }:
                                <button type="button" class="btn" @onclick="() => Enable(entry)" disabled="@_busy">启用</button>
                                <button type="button" class="btn btn-danger" @onclick="() => Remove(entry)"
                                        disabled="@_busy">移除</button>
                                break;
                            case { Status: OBSharpPluginStatus.Failed }:
                                <button type="button" class="btn btn-danger" @onclick="() => Remove(entry)"
                                        disabled="@_busy">移除</button>
                                break;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _busy;

    // 交互式渲染下组件是长活的；状态变化（别的会话改了插件列表）时刷新。
    protected override void OnInitialized() => State.Changed += OnStateChanged;

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnStateChanged;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter")
            await Add();
    }

    private async Task Add()
    {
        var result = await FilePicker.OpenFileAsync(new()
        {
            Title = "选择插件文件",
            Filters = ["插件程序集|*.dll", "所有文件|*"]
        });
        if (result.Canceled || result.Path is not { } path || !File.Exists(path))
            return;

        await Run(() =>
        {
            var added = Manager.Add(path);
            if (added is null)
                return false;

            State.Info($"已添加 {Describe(added)}，默认是停用的，点「启用」才会加载。");
            return true;
        });
    }

    private async Task Enable(OBSharpPluginInfo entry) => await Run(() =>
    {
        if (Manager.Load(entry))
        {
            State.Info($"已启用 {Describe(entry)}。");
            return true;
        }

        State.Fail($"启用 {Describe(entry)} 失败：{entry.Exception?.Message ?? "原因见上方"}。");
        return false;
    });

    private async Task Disable(OBSharpPluginInfo entry) => await Run(() =>
    {
        Manager.Unload(entry);
        State.Info($"已停用 {Describe(entry)}。");
        return true;
    });

    private async Task Remove(OBSharpPluginInfo entry) => await Run(() =>
    {
        Manager.Remove(entry);
        State.Info($"已移除 {Describe(entry)}。");
        return true;
    });

    // 所有操作都套一层：置忙、接异常、最后刷新。
    private async Task Run(Func<bool> action)
    {
        if (_busy)
            return;

        _busy = true;
        try
        {
            if (!action())
                return;
        }
        catch (Exception ex)
        {
            State.Fail(ex.Message);
        }
        finally
        {
            _busy = false;
        }

        // 让界面先画出 _busy=false，再交还 UI。
        await Task.CompletedTask;
    }

    private static string Describe(OBSharpPluginInfo entry) => entry.Name ?? entry.Path;
}
