<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RootNamespace>OBSharp</RootNamespace>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- 宿主固定跑在 ASP.NET Core 上（Loader 启动 CoreCLR 时带着 Microsoft.AspNetCore.App）：
         ILogger、DI、Configuration、Options 都在共享框架里，不用再单独引包；
         插件要用 ASP.NET Core 的类型也照着这么绑。 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OBSharp.SDK\OBSharp.SDK.csproj" />
    <ProjectReference Include="..\OBSharp.Interop\OBSharp.Interop.csproj" />
  </ItemGroup>
  
</Project>
