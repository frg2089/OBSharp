    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OBSharp.SDK\OBSharp.SDK.csproj" />
  </ItemGroup>
  
</Project>